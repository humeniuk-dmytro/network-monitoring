# ============================================================
# Network Monitoring System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secret-key-change-me

# Application environment: development | production | testing
FLASK_ENV=development

# Flask debug mode (set to 0 in production)
FLASK_DEBUG=1

# Database URL (default: SQLite in ./database/)
# For PostgreSQL: postgresql://user:password@localhost:5432/network_monitoring
DATABASE_URL=sqlite:///database/network_devices.db

# SSH password encryption key (any strong random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SSH_ENCRYPTION_SECRET=your-encryption-secret-change-me

# Salt for SSH password KDF (any random bytes as string)
PASSWORD_SALT_SSH=your-random-salt-change-me

# --- Ping settings ---
PING_PACKET_COUNT_LINUX=2
PING_TIMEOUT_SEC_LINUX=1
PING_PACKET_COUNT_WINDOWS=2
PING_TIMEOUT_MS_WINDOWS=1000
PING_COMMUNICATE_TIMEOUT=3
